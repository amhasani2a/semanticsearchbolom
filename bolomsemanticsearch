drive.mount('/content/drive', force_remount=True)
DB_DUMP_PATH = '/content/drive/MyDrive/search_engine_dump.sql'

if os.path.exists(DB_DUMP_PATH):
    subprocess.run(f'sudo -u postgres psql postgres < "{DB_DUMP_PATH}"', shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

conn = psycopg.connect("host=127.0.0.1 dbname=postgres user=postgres password=postgres", autocommit=True)
